body {
  font-family: Arial, sans-serif;
  background: #f4f4f4;
  margin: 0;
  padding: 30px;
}

main {
  max-width: 700px;
  margin: auto;
  background: white;
  padding: 25px;
  border-radius: 10px;
}

h1 {
  color: #222;
}

input[type="text"] {
  width: 90%;
  padding: 10px;
  margin-bottom: 15px;
}

input[type="checkbox"] {
  margin-right: 8px;
}

li {
  margin-bottom: 15px;
  padding: 10px;
  background: #f1f1f1;
  border-radius: 5px;
}